# Public Supabase browser credentials. Do not put the service-role secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Canonical origin used for authentication callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only transactional invitation email configuration.
# Never expose these as NEXT_PUBLIC variables or commit real credentials.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
