# Public Supabase browser credentials. Do not put the service-role secret here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Canonical origin used for authentication callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only transactional invitation email configuration.
# Never expose these as NEXT_PUBLIC variables or commit real credentials.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=

# Server-only OpenAI configuration for the real workspace Agent.
# Never expose the API key as a NEXT_PUBLIC variable or commit a real credential.
OPENAI_API_KEY=
# Optional override. R4A defaults to gpt-5.6-terra when omitted.
OPENAI_AGENT_MODEL=gpt-5.6-terra
